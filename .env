# Backend integration (sr-backend runs on port 4000 by default)
# For Android emulator use http://10.0.2.2:4000/api
# For a physical device use your machine's LAN IP, e.g. http://192.168.1.5:4000/api
# EXPO_PUBLIC_API_URL=http://192.168.1.47:4000/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_APP_NAME=RestaurantTouchPOS
